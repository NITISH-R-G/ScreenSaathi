<?xml version="1.0" encoding="utf-8"?>
<!--
  The controlled screen the assistant guides. Real views with real ids
  (amount_field, account_field, submit_button) — read live over accessibility,
  so the highlight position is never baked in. This is what makes the demo
  provably not scripted.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_title"
            android:textColor="#FF10131A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="State Electricity Board"
            android:textColor="#80101010"
            android:textSize="15sp"
            android:paddingBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bill amount (₹)"
            android:textColor="#FF10131A"
            android:textSize="15sp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/amount_field"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="0"
            android:inputType="number"
            android:textSize="18sp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/field_bg"
            android:importantForAccessibility="yes" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account number"
            android:textColor="#FF10131A"
            android:textSize="15sp"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/account_field"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. 100234567"
            android:inputType="number"
            android:textSize="18sp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/field_bg"
            android:importantForAccessibility="yes" />

        <Button
            android:id="@+id/submit_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="36dp"
            android:text="Pay Bill"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <TextView
            android:id="@+id/status_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FF1B8A5A"
            android:textSize="16sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
