<?xml version="1.0" encoding="utf-8"?>
<!-- The floating assistant, anchored at the bottom of the screen. Collapsed =
     the pill row only. Expanded = the card body unfolds ABOVE the pill row so
     the pill stays put at the bottom edge and the card grows upward, never
     covering the form fields the highlight points at. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/pill_bg"
    android:padding="10dp"
    android:elevation="12dp">

    <!-- Card body: shown only when expanded. Sits ABOVE the pill row. -->
    <LinearLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the mic and tell me what you want to do."
            android:textColor="@color/saathi_text"
            android:textSize="16sp"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="12dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Choice row: one button per option (e.g. the ride apps on this
             phone). Hidden unless the current step actually asks something. -->
        <LinearLayout
            android:id="@+id/choice_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/choice_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/mic_btn_bg"
                android:gravity="center"
                android:textColor="@color/saathi_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/choice_1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/mic_btn_bg"
                android:gravity="center"
                android:textColor="@color/saathi_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/choice_2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/mic_btn_bg"
                android:gravity="center"
                android:textColor="@color/saathi_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
          The single voice surface. Exactly one child is ever visible:

            IDLE / GUIDING -> transport_row (mic, Next, Stop)
            LISTENING / THINKING / SPEAKING -> waveform

          Both occupy the same fixed-height slot, so swapping between them
          cannot move anything else in the card — the mic's touch target stays
          where the mic was drawn, and the row below never shifts under the
          user's finger mid-tap.
        -->
        <FrameLayout
            android:id="@+id/voice_slot"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <LinearLayout
                android:id="@+id/transport_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/mic_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/mic_circle_bg"
                    android:src="@drawable/ic_mic"
                    android:scaleType="center"
                    android:contentDescription="@string/mic_label"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/next_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/ghost_btn_bg"
                    android:text="Next"
                    android:gravity="center"
                    android:textColor="@color/saathi_text"
                    android:textSize="14sp" />

                <!-- Stop: always reachable, so the user can call the guidance off
                     mid-sentence without force-quitting anything. -->
                <TextView
                    android:id="@+id/stop_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ghost_btn_bg"
                    android:text="■"
                    android:gravity="center"
                    android:textColor="@color/saathi_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Tappable too: while listening the mic is gone, and tapping the
                 wave is the obvious way to say "I'm done". -->
            <com.screensaathi.overlay.VoiceWaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Debug panel (M5). Hidden by default; toggled by long-pressing the pill. -->
        <TextView
            android:id="@+id/debug_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/saathi_text_dim"
            android:textSize="11sp"
            android:visibility="gone"
            android:text="" />
    </LinearLayout>

    <!-- Pill row: always visible. Tap to expand/collapse. Stays at the bottom. -->
    <LinearLayout
        android:id="@+id/pill_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <!-- The at-a-glance indicator for the COLLAPSED pill only. When
             card_body is expanded, mic_button already shows the same state
             at 52dp — showing both at once is exactly the "mic + orb + text
             all together" clutter this was rebuilt to remove, so
             setExpanded() hides this the instant card_body appears. -->
        <com.screensaathi.overlay.StateOrbView
            android:id="@+id/state_dot"
            android:layout_width="18dp"
            android:layout_height="18dp" />

        <TextView
            android:id="@+id/pill_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="ScreenSaathi"
            android:textColor="@color/saathi_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Which language the assistant is currently speaking. Visible proof
             that detection happened, without a debug panel. -->
        <TextView
            android:id="@+id/language_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="#22FFFFFF"
            android:text="English"
            android:textColor="@color/saathi_text_dim"
            android:textSize="12sp" />
            
        <TextView
            android:id="@+id/close_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:text="✖"
            android:gravity="center"
            android:textColor="@color/saathi_text_dim"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
