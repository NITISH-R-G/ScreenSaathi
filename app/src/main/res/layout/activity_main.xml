<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FF0B0B0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ScreenSaathi"
            android:textColor="@color/saathi_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One-time setup. Grant these, then the assistant lives as a floating pill."
            android:textColor="@color/saathi_text_dim"
            android:textSize="15sp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="1. Allow display over other apps"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <Button
            android:id="@+id/btn_mic"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="2. Allow microphone"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="3. Turn on ScreenSaathi screen reader"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:text="Start assistant"
            android:textStyle="bold"
            android:textColor="#FF0B0B0F"
            android:backgroundTint="@color/saathi_highlight" />

        <!-- Rehearsal: run a task without speaking. Same engine, overlay and
             cursor as a spoken request, minus STT — for a room too loud to
             trust a microphone. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rehearse without speaking"
            android:textColor="@color/saathi_text_dim"
            android:textSize="13sp"
            android:paddingTop="22dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_taxi_en"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Taxi EN" />

            <Button
                android:id="@+id/btn_taxi_hi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="टैक्सी HI" />

            <Button
                android:id="@+id/btn_taxi_ta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="டாக்ஸி TA" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_demo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Open demo screen (Pay Bill)"
            android:textColor="@color/saathi_text"
            android:backgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/saathi_text_dim"
            android:textSize="14sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
