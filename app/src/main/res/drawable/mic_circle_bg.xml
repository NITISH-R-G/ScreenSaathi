<?xml version="1.0" encoding="utf-8"?>
<!-- The idle affordance: a restrained translucent disc, not a saturated
     button. It should read as a system control that is available, not as a
     call-to-action competing with the app underneath. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#26FFFFFF" />
    <stroke android:width="1dp" android:color="#3DFFFFFF" />
</shape>
