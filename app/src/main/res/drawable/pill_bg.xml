<?xml version="1.0" encoding="utf-8"?>
<!-- Values ported from Tappr's OverlayModule.createNotch(): near-black
     top-to-bottom sheen, 19dp corners, a translucent white stroke bright
     enough to read on a pure-black app underneath. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1C1C24"
        android:endColor="#0A0A0E" />
    <corners android:radius="19dp" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
</shape>
